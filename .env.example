# Copy to .env and fill in values. Never commit the real .env file.
# The Mistral API key lives ONLY in Supabase Edge Function secrets — it must
# never appear in this file or anywhere in the client bundle.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: OAuth redirect scheme used by supabase_flutter for deep links.
APP_DEEPLINK_SCHEME=io.ironcoach.app

# Public flag only — does not enable/disable server behavior.
ENVIRONMENT=development
